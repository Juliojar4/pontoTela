SESSION_SECRET=troque-por-uma-string-aleatoria-longa
PORT=3000

# Login com Google (obrigatorias: sem elas o servidor nao sobe)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque-pelo-secret-do-google
GOOGLE_REDIRECT_URI=https://pontotela.com.br/auth/google/callback
# E-mail Google do administrador (criado/promovido a admin ao subir)
ADMIN_EMAIL=voce@gmail.com
# 64 caracteres hex que cifram o segredo do Authenticator no banco: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=troque-por-64-caracteres-hex
